# Copy to .env and fill in. Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-to-a-long-random-string
MASTER_KEY=change-me-to-a-fernet-key  # encrypts user LLM API keys at rest

# LAN bind. The app is only reachable over your WireGuard network.
# The container always listens on 8000 internally; QUIPEAT_LAN_BIND picks the
# host side, e.g. QUIPEAT_LAN_BIND=127.0.0.1:37411:8000 in docker-compose maps
# host port 37411 -> container 8000. BIND_ADDR/PORT only change the in-container
# listener (leave defaults).
BIND_ADDR=0.0.0.0
PORT=8000
# QUIPEAT_LAN_BIND=127.0.0.1:8000:8000

# Auth: password login works now. Flip to true (with HTTPS, see README) to enable passkeys.
PASSKEYS_ENABLED=false
RP_ID=localhost
RP_NAME=Quipeat

# Set LLM_MOCK=true to run generation against a deterministic mock (tests/dev without API key).
LLM_MOCK=false
